generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id            String   @id
  vehicleNumber String   @unique
  model         String
  manufacturer  String
  vehicleType   String
  fleetName     String
  status        String

  alerts        Alert[]

  createdAt     DateTime @default(now())
}

model Driver {
  id            String   @id
  name          String
  licenseNumber String   @unique
  safetyScore   Float    @default(100)

  createdAt     DateTime @default(now())
}

model Alert {
  id         Int      @id @default(autoincrement())

  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  alertType  String
  riskScore  Float

  createdAt  DateTime @default(now())
}